{
  "name": "@agracio/node-expat",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.4.4",
  "main": "./lib/node-expat",
  "gypfile": true,
  "description": "NodeJS binding for fast XML parsing.",
  "keywords": [
    "xml",
    "sax",
    "expat",
    "libexpat",
    "parse",
    "parsing"
  ],
  "files": [
    "lib",
    "deps",
    "binding.gyp",
    "node-expat.cc",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install": "node-gyp rebuild --enable_thin_lto=false --enable_lto=false",
    "rebuild": "node-gyp rebuild --enable_thin_lto=false --enable_lto=false",
    "preversion": "npm test",
    "lint": "standard",
    "unit": "vows --spec ./test/**/*.js",
    "test": "npm run unit && npm run lint",
    "benchmark": "node ./benchmark.js"
  },
  "dependencies": {
    "nan": "^2.27.0",
    "node-gyp": "^12.3.0"
  },
  "devDependencies": {
    "benchmark": "^2.1.4",
    "debug": "^4.4.3",
    "ltx": "^3.1.2",
    "node-xml": "^1.0.2",
    "prebuild": "^13.0.1",
    "sax": "^1.6.0",
    "standard": "^17.1.2",
    "vows": "^0.8.3"
  },
  "repository": "github:agracio/node-expat",
  "homepage": "http://github.com/agracio/node-expat",
  "bugs": "https://github.com/agracio/node-expat/issues",
